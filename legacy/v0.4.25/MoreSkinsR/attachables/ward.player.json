{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "pa:ward.player",
      "item": {
        "pa:ward": "query.owner_identifier == 'minecraft:player'"
      },
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/entity/pamobile/ward",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.ward"
      },
      "animations": {
        "idle": "animation.ward.idle",
        "fly": "animation.ward.fly",
        "fly_move": "animation.ward.fly_move",
        "walk": "animation.ward.walk",
        "sit": "animation.ward.sit",
        "run": "animation.ward.run",
        "jump": "animation.ward.jump",
        "control": "controller.animation.ward"
      },
      "scripts": {
        "animate": [
          "control"
        ]
      },
      "render_controllers": [
        "controller.render.armor"
      ]
    }
  }
}