            },
            {
              "swim": "q.is_swimming"
            },
            {
              "ride": "q.is_riding"
            },
            {
              "sneaking": "(q.is_sneaking&&q.modified_move_speed>0.05)&&(q.is_on_ground||q.is_in_water)"
            },
            {
              "sneak": "(q.is_sneaking&&q.modified_move_speed<=0.05)&&(q.is_on_ground||q.is_in_water)"
            },
            {
              "jump": "(!q.is_on_ground&&!q.is_in_water)"
