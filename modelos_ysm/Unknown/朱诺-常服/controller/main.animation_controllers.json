{
	"format_version": "1.19.0",
	"animation_controllers": {
		"player.pre_main": {
			"states": {
				"default": {
					"animations": []
				}
			}
		},
		"player.post_main": {
			"states": {
				"default": {
					"animations": []
				}
			}
		},
		"player.pre_hold": {
			"states": {
				"default": {
					"animations": []
				}
			}
		},
		"player.post_hold": {
			"states": {
				"default": {
					"animations": []
				}
			}
		},
		"player.post_use": {
			"states": {
				"default": {
					"animations": []
				}
			}
		},
		"player.pre_swing": {
			"states": {
				"default": {
					"animations": []
				}
			}
		},
		"player.post_swing": {
			"states": {
				"default": {
					"animations": []
				}
			}
		},
		"player.pre_use": {
			"states": {
				"default": {
					"animations": ["attack_empty"],
					"on_exit": ["v.swing_sword=0;v.attack=math.mod(v.attack+1,3);"],
					"transitions": [
						{"attack1": "v.swing_sword&&v.attack==0&&!v.jump"},
						{"attack2": "v.swing_sword&&v.attack==1&&!v.jump"},
						{"attack3": "v.swing_sword&&v.attack==2&&!v.jump"},
						{"attack_jump": "v.swing_sword&&v.jump"}
					]
				},
				"attack1": {
					"animations": [
						{"sword_attack_01": "!ctrl.idle"},
						{"sword_idle_attack_01": "ctrl.idle"}
					],
					"on_exit": ["v.swing_sword=0;v.attack=math.mod(v.attack+1,3);"],
					"transitions": [
						{"attack2": "v.swing_sword&&v.attack==1&&!v.jump"},
						{"default": "q.all_animations_finished"},
						{"attack_jump": "v.swing_sword&&v.jump"}
					],
					"blend_transition": 0.05,
					"blend_via_shortest_path": true
				},
				"attack2": {
					"animations": [
						{"sword_attack_02": "!ctrl.idle"},
						{"sword_idle_attack_02": "ctrl.idle"}
					],
					"on_exit": ["v.swing_sword=0;v.attack=math.mod(v.attack+1,3);"],
					"transitions": [
						{"attack3": "v.swing_sword&&v.attack==2&&!v.jump"},
						{"default": "q.all_animations_finished"},
						{"attack_jump": "v.swing_sword&&v.jump"}
					],
					"blend_transition": 0.05,
					"blend_via_shortest_path": true
				},
				"attack3": {
					"animations": [
						{"sword_attack_03": "!ctrl.idle"},
						{"sword_idle_attack_03": "ctrl.idle"}
					],
					"on_exit": ["v.swing_sword=0;v.attack=math.mod(v.attack+1,3);"],
					"transitions": [
						{"default": "q.all_animations_finished"},
						{"attack1": "v.swing_sword&&v.attack==0&&!v.jump"},
						{"attack_jump": "v.swing_sword&&v.jump"}
					],
					"blend_transition": {
						"0.0": 1,
						"0.0056": 0.96985,
						"0.0111": 0.88302,
						"0.0167": 0.75,
						"0.0222": 0.58682,
						"0.0278": 0.41318,
						"0.0333": 0.25,
						"0.0389": 0.11698,
						"0.0445": 0.03015,
						"0.05": 0
					},
					"blend_via_shortest_path": true
				},
				"attack_jump": {
					"animations": ["sword_jump_attack"],
					"on_exit": ["v.swing_sword=0;v.attack=math.mod(v.attack+1,3);"],
					"transitions": [
						{"default": "q.all_animations_finished"},
						{"attack1": "v.swing_sword&&!v.jump"}
					],
					"blend_transition": 0.05,
					"blend_via_shortest_path": true
				}
			}
		}
	}
}