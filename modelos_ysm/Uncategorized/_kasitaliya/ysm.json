{"spec":2,"metadata":{"authors":[{"avatar":"avatar/晓苯升易.png","comment":"苯狐狸提可拉 洁丽娅","contact":{"Afdian":"https://afdian.com/a/6TGESILA","Bilibili":"https://space.bilibili.com/17798027"},"name":"晓苯升易","role":"[模型，贴图，动画]"}],"license":{"desc":"","type":"ALL Rights Reserved"},"link":{"donate":"https://afdian.com/a/6Canim","home":"https://space.bilibili.com/326133289?spm_id_from=333.1007.0.0"},"name":"卡斯塔莉娅","tips":"卡斯塔莉娅看上去是一位温柔可亲的女孩子，待人接物也都十分亲切，似乎从来没有人见过她生气的样子。\n不过当与莉娅相处久了以后，就会发现莉娅说话的时候非常腹黑，有些s的倾向。\n相比起当个乖巧的助手，莉娅更喜欢享受捉弄阁下的感觉，不过对于阁下的喜爱莉娅也觉得自己并不输给任何人，这就是所谓的喜欢也有着多种形式吧。\n莉娅平时喜欢画画，但却不会轻易将画作公之于众，也许在这方面她有着自己的考虑吧。\n在她的身边有一只名为贝果的宠物，性格有些调皮，经常闯祸，不过是不是莉娅将自己的恶作剧推到贝果的头上就不得而知了。"},"properties":{"width_scale":0.7,"height_scale":0.7,"extra_animation":{"extra0":"横坐","extra1":"招呼","extra2":"鼓掌","extra3":"可以","extra4":"不行","extra5":"ODL","extra6":"手摇","extra7":"doodle摇","extra9":"#example_config"},"extra_animation_buttons":[{"id":"example_config","name":"动画控制","config_forms":[{"type":"range","title":"嘴型控制: ","description":"0无，1微笑","value":"v.value_facerange","step":1.0,"min":0.0,"max":1.0}]}],"extra_animation_classify":[],"default_texture":"default","preview_animation":"idle","free":true,"render_layers_first":false,"all_cutout":false,"disable_preview_rotation":false},"files":{"player":{"model":{"main":"models/main.json","arm":"models/arm.json"},"animation":{"main":"animations/main.animation.json"},"animation_controllers":[],"texture":[{"uv":"textures/main.png"}]}}}